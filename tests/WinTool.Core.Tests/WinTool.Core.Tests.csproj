    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 自带 Microsoft.Testing.Platform，直接 dotnet run 即可跑（不需要 VSTest 宿主）。 -->
