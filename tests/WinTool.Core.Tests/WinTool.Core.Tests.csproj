  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinTool.Core\WinTool.Core.csproj" />
  </ItemGroup>

</Project>
